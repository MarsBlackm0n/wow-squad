# --- Base de données ------------------------------------------------------
# Sur Railway : ajouter un service PostgreSQL puis référencer sa variable (DATABASE_URL=${{Postgres.DATABASE_URL}}).
# En local, sans valeur : SQLite dans ./data/squad.sqlite3
DATABASE_URL=

# --- API Battle.net (develop.battle.net) — obligatoire -----------------------
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# BLIZZARD_REGION=eu
# BLIZZARD_LOCALE=fr_FR

# --- Site ---------------------------------------------------------------
# Mot de passe partagé entre potes pour accéder au QG (vide = site ouvert à tous)
SITE_PASSWORD=
# Clé de signature des sessions : une longue chaîne aléatoire (python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=
# URL publique (sert au retour de la connexion Battle.net). Déduite de RAILWAY_PUBLIC_DOMAIN si absente.
# PUBLIC_URL=https://wow-squad.up.railway.app
# SQUAD_NAME=La Squad

# --- Notifications (facultatif, l'un ou l'autre ou les deux) ----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Réglages (valeurs par défaut) --------------------------------------
# REFRESH_INTERVAL=900     # secondes entre deux synchros (min. 120)
# LIVE_EVENTS=true         # pousse paliers, hauts faits, montures en direct
# RECAP_WEEKDAY=2          # 0 = lundi ... 6 = dimanche, -1 pour désactiver le récap
# RECAP_HOUR=10            # heure de Paris
# TZ_NAME=Europe/Paris